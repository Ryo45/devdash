[Unit]
Description=devdash headless workload dashboard Core
After=dbus.socket

[Service]
Type=simple
ExecStart="%h/.local/share/devdash/current/bin/python" -I -m devdash --socket "%t/devdash-python/core.sock" daemon --config "%h/.config/devdash/config.yaml"
WorkingDirectory=%h
Environment=PYTHONUNBUFFERED=1 PYTHONNOUSERSITE=1
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
UnsetEnvironment=PYTHONPATH PYTHONHOME DISPLAY WAYLAND_DISPLAY
RuntimeDirectory=devdash-python
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
KillMode=control-group
StandardOutput=journal
StandardError=journal
SyslogIdentifier=devdash-core

[Install]
WantedBy=default.target
